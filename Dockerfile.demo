# syntax=docker/dockerfile:1
# Omniflow hosted DEMO: the whole emulated stack (apps/devstack) — local chain, contracts, bundler, emulators, API,
# dashboard and claim page — behind one port. Test money only; not a production image (that is Dockerfile.api).
# Build from omniflow/:  docker build -f Dockerfile.demo -t omniflow-demo .
# Run:  docker run -e PUBLIC_URL=https://demo.example -e DEVSTACK_DATABASE_URL=postgres://…/omniflow_dev -p 8080:8080 omniflow-demo
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*

# anvil and forge (the versions the stack is tested with), and solc where contracts/foundry.toml expects it
ARG FOUNDRY_VERSION=v1.5.1
RUN curl -fsSL "https://github.com/foundry-rs/foundry/releases/download/${FOUNDRY_VERSION}/foundry_${FOUNDRY_VERSION}_linux_amd64.tar.gz" | tar -xz -C /usr/local/bin anvil forge
RUN mkdir -p /root/.solc \
 && curl -fsSL -o /root/.solc/solc-0.8.28 "https://binaries.soliditylang.org/linux-amd64/solc-linux-amd64-v0.8.28+commit.7893614a" \
 && chmod +x /root/.solc/solc-0.8.28
ENV FOUNDRY_BIN=/usr/local/bin

WORKDIR /app
COPY . .
# development dependencies included: the stack builds both frontends at start (their URLs are known only then)
RUN npm ci --no-audit --no-fund && npm cache clean --force
RUN cd contracts && forge build

ENV PORT=8080
EXPOSE 8080
# DEVSTACK_DATABASE_URL (a database named *_dev — it is recreated on every start) and PUBLIC_URL come from the host
CMD ["npm", "run", "dev:stack"]
