# Dashboard build settings (Vite). Public values only — nothing secret goes into a frontend bundle.
# The dashboard always offers a choice: Demo or Real. A mode is available when its settings are present.

# Real mode
VITE_API_URL=
VITE_PRIVY_APP_ID=

# Demo mode (`npm run dev:stack` fills these itself)
VITE_DEMO_API_URL=
VITE_DEMO_AUTH_URL=
VITE_DEMO_EXAMPLE_URL=

# Landing page: "Source on GitHub" appears when set. Visitors see it only if the repository is public.
VITE_SOURCE_URL=
