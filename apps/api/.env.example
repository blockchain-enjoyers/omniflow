# Omniflow API — copy to .env and fill. Never commit real values.
# Tests read TEST_DATABASE_URL; `npm run dev:stack` reads DEVSTACK_DATABASE_URL (both are recreated: names must end in _dev/_test).
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/omniflow_dev
TEST_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/omniflow_test
DEVSTACK_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/omniflow_dev

# ---- chain (Arbitrum only). Every address: eth_getCode on the target network before use.
CHAIN_ID=421614
RPC_URL=
ENTRYPOINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
KERNEL_FACTORY=
WEIGHTED_VALIDATOR=
ESCROW=
TOKEN=
TOKEN_DECIMALS=6
# EOA that only pays gas to relay already-signed operations; holds no rights over funds
SUBMITTER_PRIVATE_KEY=

# ---- Privy: either the real app (dashboard → App settings) …
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# … or the EMULATOR (development only)
PRIVY_EMULATOR_URL=

# ---- bundler + paymaster (ZeroDev) — the project RPC from dashboard.zerodev.app.
# A gas policy must be enabled in the dashboard, or nothing is sponsored.
ZERODEV_RPC=
# … alternatives: any ERC-4337 bundler + an ERC-7677 paymaster
BUNDLER_URL=
PAYMASTER_URL=
# … or no bundler (the API calls handleOps) with the emulated reference VerifyingPaymaster (local chain / fork only)
PAYMASTER_ADDRESS=
PAYMASTER_SIGNER_KEY=

# 32 bytes hex, from the secret manager — encrypts claim keys until the email is sent
CLAIM_KEY_ENCRYPTION_KEY=
APP_URL=http://localhost:5173/
CLAIM_BASE_URL=http://localhost:5174/
FORM_BASE_URL=http://localhost:5173/
CLAIM_TIP_UNITS=50000
MAX_ROWS_PER_BATCH=40

# partner not chosen — the emulator, or empty
ONRAMP_EMULATOR_URL=
# 1 = /dev/mailbox (emulated mail). Never in production.
DEV_ENDPOINTS=
TICK_MS=15000
